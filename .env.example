# Copy to .env and fill in. Never commit .env (it holds your bot token).

# --- Telegram (required) ---
# Create a bot with @BotFather in Telegram -> /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=
# Your chat id. Message your bot once, then run:  python disaster_alert_bot.py --get-chat-id
# Several ids allowed, comma-separated (e.g. you + a family group).
TELEGRAM_CHAT_ID=

# --- What to watch ---
# TH = Thailand (TMD), ID = Indonesia (BMKG)
COUNTRIES=TH,ID
# en = English feeds, local = Thai (TMD) / Indonesian (BMKG) feeds
ALERT_LANG=en
# Lowest CAP severity to send: Minor | Moderate | Severe | Extreme
MIN_SEVERITY=Severe
# Only send warnings that mention these places (comma-separated, case-insensitive).
# Empty = whole country. Tip: add the region word TMD uses too, e.g. "North".
AREA_KEYWORDS=
# Include warnings that have no severity level (TMD numbered bulletins, plain BMKG items)
INCLUDE_BULLETINS=true
# Skip "Update" messages for warnings you already got
SKIP_CAP_UPDATES=false

# --- Earthquakes ---
MIN_QUAKE_MAG=5.0
# Your location, for "km from you" and the radius filter (Chiang Mai shown as an example)
HOME_LAT=
HOME_LON=
# 0 = no radius limit. Quakes with tsunami potential are always sent.
QUAKE_RADIUS_KM=0
# Add USGS (US agency) quakes around Thailand/Myanmar, as TMD has no public quake API
ENABLE_USGS=true

# --- Groups ---
# Add the bot to a Telegram group and it posts alerts there by itself (true/false)
AUTO_SUBSCRIBE=true
# Welcome people who join a group, with the warnings active right now
WELCOME_NEW_MEMBERS=true

# --- Running ---
POLL_SECONDS=120
STATE_FILE=state.json
# Send "still running" every N hours (0 = off)
HEARTBEAT_HOURS=24
# Warn in Telegram if a source fails this many checks in a row
SOURCE_FAIL_ALERT_AFTER=15
# Only if a government site has a broken SSL certificate
INSECURE_SSL=false
